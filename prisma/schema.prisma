generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("CLIENT")
  phone         String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones Cliente
  servicesPosted ServiceRequest[] @relation("ClientServices")
  reviewsGiven   Review[]         @relation("ReviewsGiven")

  // Relaciones Prestador
  servicesDone   ServiceRequest[] @relation("ProviderServices")
  reviewsReceived Review[]        @relation("ReviewsReceived")
  skills         Skill[]          @relation("UserSkills")
  
  // Chat
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique // Ej: "Gasfitería", "Electricidad"
  users       User[]   @relation("UserSkills")
}

model ServiceRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  urgency     String   @default("NORMAL") // URGENT, NORMAL, LOW
  minPrice    Float?
  maxPrice    Float?
  status      String   @default("PUBLISHED")
  latitude    Float?
  longitude   Float?
  // No array en SQLite (solo String)
  images      String   @default("[]") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId    String
  client      User     @relation("ClientServices", fields: [clientId], references: [id])

  providerId  String?
  provider    User?    @relation("ProviderServices", fields: [providerId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  authorId    String
  author      User     @relation("ReviewsGiven", fields: [authorId], references: [id])

  targetId    String
  target      User     @relation("ReviewsReceived", fields: [targetId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)

  senderId    String
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])

  receiverId  String
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])
}
